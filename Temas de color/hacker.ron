// ==================================================================
// Tema "Hacker" para COSMIC — terminal Matrix / fósforo verde
//
// Negro casi puro con un leve tinte verde, texto verde fósforo,
// acento verde Matrix (#00FF41), avisos en ámbar de monitor antiguo
// y errores en rojo neón. Esquinas totalmente rectas, interfaz
// compacta (más información en menos espacio) y barra/menús de
// cristal oscuro semitransparente, como un "HUD".
//
// Cómo ponerlo: Configuración → Escritorio → Apariencia → Importar
// y elegir este archivo. Después: Menú → "Estilo: Guardar cambios".
// ==================================================================
(
    // Color principal: botones destacados, selección, interruptores.
    accent: Some("#00FF41FF"),
    // Grosor en píxeles del borde de la ventana activa.
    active_hint: 2,
    alpha_map: (
        extremely_low: 0.9,
        extremely_low_2: 0.87692,
        very_low: 0.85385,
        very_low_2: 0.83076,
        low: 0.80769,
        low_2: 0.78461,
        medium: 0.76154,
        medium_2: 0.73846,
        high: 0.71538,
        high_2: 0.69231,
        very_high: 0.66023,
        very_high_2: 0.64615,
        extremely_high: 0.62308,
        extremely_high_2: 0.6,
    ),
    // Fondo de las ventanas.
    bg_color: Some("#050C06FF"),
    // Redondeo de esquinas. xs: tarjetas · s: campos y ventanas (+4 px)
    // · m: menús desplegables · l: menús del panel · xl: botones.
    corner_radii: (
        radius_0: (0.0, 0.0, 0.0, 0.0),
        radius_xs: (0.0, 0.0, 0.0, 0.0),
        radius_s: (0.0, 0.0, 0.0, 0.0),
        radius_m: (0.0, 0.0, 0.0, 0.0),
        radius_l: (0.0, 0.0, 0.0, 0.0),
        radius_xl: (0.0, 0.0, 0.0, 0.0),
    ),
    destructive: Some("#FF3355FF"),
    // Transparencia con desenfoque (Low = sutil, Medium = media).
    frosted: Low,
    frosted_applets: true,
    frosted_panel: true,
    frosted_system_interface: true,
    frosted_windows: false,
    // Separación entre ventanas en mosaico (exterior, interior).
    gaps: (0, 8),
    // Tono de los botones normales y controles.
    neutral_tint: Some("#426F4CFF"),
    // Paleta interna: la usan campos de texto, interruptores, barras de
    // desplazamiento, las apps GTK y los colores de énfasis que ofrece
    // Apariencia (accent_*).
    palette: Dark((
        name: "hacker-matrix",
        bright_red: "#FF5C7AFF",
        bright_green: "#39FF14FF",
        bright_orange: "#FFB000FF",
        gray_1: "#050C06FF",
        gray_2: "#09160CFF",
        neutral_0: "#000000FF",
        neutral_1: "#00220AFF",
        neutral_2: "#0B3A1AFF",
        neutral_3: "#265231FF",
        neutral_4: "#3D6A47FF",
        neutral_5: "#56845FFF",
        neutral_6: "#709F79FF",
        neutral_7: "#89B992FF",
        neutral_8: "#A4D5ADFF",
        neutral_9: "#BFF1C8FF",
        neutral_10: "#FFFFFFFF",
        accent_blue: "#00E5FFFF",
        accent_indigo: "#6C7BFFFF",
        accent_purple: "#C04DFFFF",
        accent_pink: "#FF2E97FF",
        accent_red: "#FF3355FF",
        accent_orange: "#FF9F1CFF",
        accent_yellow: "#FFE500FF",
        accent_green: "#00FF41FF",
        accent_warm_grey: "#8DB89AFF",
        ext_warm_grey: "#5E7A66FF",
        ext_orange: "#FF9F1CFF",
        ext_yellow: "#FFE500FF",
        ext_blue: "#00B3FFFF",
        ext_purple: "#B14DFFFF",
        ext_pink: "#FF007FFF",
        ext_indigo: "#4D5BFFFF",
    )),
    // Fondo de barras laterales y tarjetas (primario) y de lo que va
    // dentro de ellas (secundario).
    primary_container_bg: Some("#09160CFF"),
    secondary_container_bg: Some("#0F2013FF"),
    spacing: (
        space_none: 0,
        space_xxxs: 4,
        space_xxs: 4,
        space_xs: 8,
        space_s: 8,
        space_m: 16,
        space_l: 24,
        space_xl: 32,
        space_xxl: 48,
        space_xxxl: 64,
    ),
    success: Some("#00FF9CFF"),
    // Tono del texto (None = gris neutro).
    text_tint: Some("#9FF7A5FF"),
    warning: Some("#FFB000FF"),
    // Color del borde de la ventana activa (None = color de acento).
    window_hint: None,
)
